package com.tienda.inventario;

import com.tienda.producto.ProductoModel;
import com.tienda.inventario.IMovimientoDAO;

public class InventarioController {

    private IMovimientoDAO inventarioDAO;

    // Constructor
    public InventarioController(IMovimientoDAO inventarioDAO) {
        this.inventarioDAO = inventarioDAO;
    }

    // Agregar producto
    public void agregarProducto(ProductoModel p) {
        inventarioDAO.agregarProducto(p);
    }

    // Actualizar stock
    public void actualizarStock(int idProducto, int cantidad) {
        inventarioDAO.actualizarStock(idProducto, cantidad);
    }

    // Buscar producto
    public ProductoModel buscarProducto(int idProducto) {
        return inventarioDAO.buscarProducto(idProducto);
    }

    // Verificar stock disponible
    public boolean verificarStock(int idProducto, int cantidadSolicitada) {

        ProductoModel producto = inventarioDAO.buscarProducto(idProducto);

        if (producto != null) {
            return producto.getStock() >= cantidadSolicitada;
        }

        return false;
    }

    // Eliminar producto
    public void eliminarProducto(int idProducto) {
        inventarioDAO.eliminarProducto(idProducto);
    }
}